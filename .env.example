# Copy to .env (never commit .env) or enter these as Portainer stack variables.

# Required: Home Assistant base URL as seen from the watchdog host.
HA_URL=http://homeassistant.local:8123

# SSH into the Advanced SSH & Web Terminal add-on (defaults: host from HA_URL, port 22, user hassio).
#SSH_HOST=
#SSH_PORT=22
#SSH_USER=hassio

# Optional: your router's IP. If HA and the gateway are both unreachable, the
# watchdog assumes its own network is down and does nothing.
#GATEWAY=

# Pushover alerts: your user key and an application's API token.
PUSHOVER_USER=
PUSHOVER_TOKEN=

# Optional MQTT check: a long-lived access token plus a comma-separated list of
# MQTT-fed entities that normally update every few minutes.
HA_TOKEN=
#MQTT_CANARIES=sensor.example_status,sensor.another_status

# 1 = alert only, never restart anything.
DRY_RUN=0

#TZ=UTC
